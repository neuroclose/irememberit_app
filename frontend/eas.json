      "ios": {
        "appleId": "chris.abston@mail.com",
        "ascAppId": "6754891284",
        "appleTeamId": "HKGXJJC89T"
      },
      "android": {
        "serviceAccountKeyPath": "./path-to-service-account.json",
        "track": "internal"
      }
    }
  }
